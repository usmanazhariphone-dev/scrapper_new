# Copy this to .env in the scraper root directory

# OpenAI — already used by existing scraper
OPENAI_API_KEY=sk-...

# Supabase — get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=eyJ...  # use the service_role key (NOT anon key)

# CRM origin for CORS (set to your deployed URL in production)
CRM_ORIGIN=http://localhost:3000
